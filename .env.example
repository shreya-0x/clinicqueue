# ========================================================
# CLINICQUEUE CONFIGURATION REFERENCE
# ========================================================

# Flask & Security
SECRET_KEY=clinicqueue-hackathon-2026-production-secret-key
FLASK_ENV=development
PORT=5000
CORS_ORIGINS=*

# Timezone Configuration (India Standard Time)
TIMEZONE=Asia/Kolkata

# Database Configuration
# Leave MONGODB_URI empty to run in Local Embedded Storage mode (zero external setup).
# Or supply your MongoDB Atlas connection string for cloud deployment:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clinicqueue?retryWrites=true&w=majority
MONGODB_URI=
DB_NAME=clinicqueue

# Demo Mode Toggle
# When enabled, seed dataset and quick-switch demo accounts are accessible.
DEMO_MODE=true

# Frontend Environment (frontend/.env)
# VITE_API_URL=http://localhost:5000/api
